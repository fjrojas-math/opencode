{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-3-sonnet",
  "rag": {
    "enabled": true,
    "embedding": {
      "provider": "openai",
      "model": "text-embedding-3-large",
      "apiKey": "{env:OPENAI_API_KEY}",
      "dimensions": 1536
    },
    "store": {
      "type": "pinecone",
      "connectionString": "{env:PINECONE_ENVIRONMENT_URL}",
      "collection": "opencode-docs",
      "options": {
        "apiKey": "{env:PINECONE_API_KEY}",
        "environment": "us-east1-gcp"
      }
    },
    "indexing": {
      "chunkSize": 1024,
      "chunkOverlap": 100,
      "autoIndex": false,
      "include": ["documentation/**/*.md", "specs/**/*.md"],
      "maxFileSize": 2097152
    },
    "retrieval": {
      "topK": 8,
      "scoreThreshold": 0.75,
      "contextWindow": 6000
    }
  }
}